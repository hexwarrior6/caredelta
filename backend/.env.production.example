# Vercel frontend
CAREDELTA_FRONTEND_ORIGIN=https://caredelta-frontend.vercel.app
CAREDELTA_FRONTEND_ORIGIN_REGEX=^https://caredelta-frontend-(?:[a-z0-9]{9}|git-[a-z0-9-]+)-hexwarrior6-projects\.vercel\.app$

# Persistence
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database-name>

# DeepSeek OpenAI-compatible API
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
