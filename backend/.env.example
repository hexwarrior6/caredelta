# Local frontend — copy to .env.local
CAREDELTA_FRONTEND_ORIGIN=http://localhost:3000
CAREDELTA_FRONTEND_ORIGIN_REGEX=

# Persistence
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>
MONGODB_DATABASE=caredelta_development

# Demo authentication (replace the secret outside local development)
DEMO_AUTH_SECRET=replace-with-a-long-random-secret
ALLOW_LEGACY_AUTH_HEADERS=false

# DeepSeek OpenAI-compatible API
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_TIMEOUT_SECONDS=30
DEEPSEEK_MAX_TOKENS=1200

# Volcengine BigModel flash ASR (server-side only)
VOLCENGINE_ASR_URL=https://openspeech.bytedance.com/api/v3/auc/bigmodel/recognize/flash
VOLCENGINE_API_KEY=replace-with-your-volcengine-api-key
VOLCENGINE_ASR_TIMEOUT_SECONDS=45
