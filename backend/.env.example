# Local frontend
CAREDELTA_FRONTEND_ORIGIN=http://localhost:3000
# Optional, for a tightly scoped Vercel preview-domain pattern.
CAREDELTA_FRONTEND_ORIGIN_REGEX=

# Persistence
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database-name>

# DeepSeek OpenAI-compatible API
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
